<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/Focusable"
    android:layout_width="116dp" android:layout_height="wrap_content" android:orientation="vertical">
    <FrameLayout android:id="@+id/card" android:layout_width="116dp" android:layout_height="170dp" android:background="@drawable/bg_card" android:foreground="@drawable/fg_card" android:duplicateParentState="true">
        <TextView android:id="@+id/fallback" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="8dp" android:textColor="@color/text_dim" android:textSize="13sp" android:maxLines="4" android:ellipsize="end" />
        <ImageView android:id="@+id/poster" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:importantForAccessibility="no" />
        <TextView android:id="@+id/star" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_margin="6dp" android:textColor="@color/accent" android:textSize="14sp" android:text="★" android:shadowColor="#000000" android:shadowRadius="4" android:visibility="gone" />
    </FrameLayout>
    <TextView android:id="@+id/title" android:textAlignment="viewStart" android:textDirection="ltr" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/text" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:background="@color/bg">
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="72dp" android:paddingEnd="40dp">
        <ImageView android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/ic_bolt" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Your TV,\nwithout the wait."
            android:textColor="@color/text" android:textSize="34sp" android:fontFamily="sans-serif-medium" android:layout_marginTop="16dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Sign in once. Your channels, movies and series stay ready on this TV."
            android:textColor="@color/text_dim" android:textSize="15sp" android:layout_marginTop="12dp" />
    </LinearLayout>
    <!-- Starts near the top so all three fields stay visible above the TV's on-screen keyboard. -->
    <LinearLayout android:layout_width="400dp" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="top" android:paddingTop="36dp" android:paddingEnd="72dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Server address" android:textColor="@color/text_dim" android:textSize="13sp" />
        <EditText android:id="@+id/server" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="4dp"
            android:background="@drawable/bg_field" android:paddingHorizontal="12dp" android:textColor="@color/text" android:textSize="15sp" android:singleLine="true"
            android:inputType="textUri" android:imeOptions="actionNext|flagNoFullscreen" android:hint="http://example.com:8080" android:textColorHint="#5C626B" android:importantForAutofill="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Username" android:textColor="@color/text_dim" android:textSize="13sp" android:layout_marginTop="10dp" />
        <EditText android:id="@+id/username" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="4dp"
            android:background="@drawable/bg_field" android:paddingHorizontal="12dp" android:textColor="@color/text" android:textSize="15sp" android:singleLine="true"
            android:inputType="text|textNoSuggestions" android:imeOptions="actionNext|flagNoFullscreen" android:importantForAutofill="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Password" android:textColor="@color/text_dim" android:textSize="13sp" android:layout_marginTop="10dp" />
        <EditText android:id="@+id/password" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="4dp"
            android:background="@drawable/bg_field" android:paddingHorizontal="12dp" android:textColor="@color/text" android:textSize="15sp" android:singleLine="true"
            android:inputType="textPassword" android:imeOptions="actionDone|flagNoFullscreen" android:importantForAutofill="no" />
        <TextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/live" android:textSize="14sp"
            android:layout_marginTop="12dp" android:visibility="gone" />
        <TextView android:id="@+id/signIn" style="@style/Pill" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="16dp"
            android:text="Sign in" android:background="@drawable/bg_key" />
    </LinearLayout>
</LinearLayout>

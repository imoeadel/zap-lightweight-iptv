<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/Focusable"
    android:layout_width="match_parent" android:layout_height="46dp" android:background="@drawable/bg_row" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="10dp" android:duplicateParentState="false">
    <TextView android:id="@+id/label" android:layout_width="44dp" android:layout_height="wrap_content" android:duplicateParentState="true" android:textColor="@color/on_row_dim" android:textSize="12sp" android:singleLine="true" />
    <ImageView android:id="@+id/logo" android:layout_width="44dp" android:layout_height="30dp" android:scaleType="fitCenter" android:importantForAccessibility="no" />
    <TextView android:id="@+id/title" android:textAlignment="viewStart" android:textDirection="ltr" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:duplicateParentState="true" android:textColor="@color/on_row" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/star" android:layout_width="wrap_content" android:layout_height="wrap_content" android:duplicateParentState="true" android:textColor="@color/on_row" android:textSize="13sp" android:text="★" android:visibility="gone" android:layout_marginStart="6dp" />
</LinearLayout>
